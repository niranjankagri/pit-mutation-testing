<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.niranjankagri</groupId>
    <artifactId>pit-mutation-testing</artifactId>
    <version>1.0.0</version>
    <name>PIT mutation testing</name>
    <description>Two test suites with the same line coverage and very different mutation scores, measured with PIT</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Which test suite to run: "strong" (default) or "weak". Both test the same production code.
          ./mvnw verify                                   strong suite, build fails below the mutation threshold
          ./mvnw verify -Dsuite=weak -Dmutation.threshold=0   weak suite, report only
        -->
        <suite>strong</suite>
        <!-- Lowest mutation score (%) the build accepts. The strong suite must kill every mutant that can be killed. -->
        <mutation.threshold>100</mutation.threshold>
        <!-- PIT mutator group: DEFAULTS, STRONGER or ALL. -Dmutators=DEFAULTS shows what the default group misses. -->
        <mutators>STRONGER</mutators>

        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <jacoco.version>0.8.16</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- Only the chosen suite, so line coverage and the mutation score describe the same tests -->
                    <includes>
                        <include>com/niranjankagri/mutation/${suite}/**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Line and branch coverage of the chosen suite: target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Mutation testing of the chosen suite: target/pit-reports/index.html -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <!-- PIT finds JUnit 5/6 tests only through this plugin -->
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.niranjankagri.mutation.cart.*</param>
                        <param>com.niranjankagri.mutation.pricing.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.niranjankagri.mutation.${suite}.*</param>
                    </targetTests>
                    <!-- STRONGER = the default mutators plus "remove conditionals" and more; see the README -->
                    <mutators>
                        <mutator>${mutators}</mutator>
                    </mutators>
                    <mutationThreshold>${mutation.threshold}</mutationThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <!-- One report folder per run would make CI artifacts and the summary script harder to find -->
                    <timestampedReports>false</timestampedReports>
                    <!-- Show which tests killed each mutant in the HTML report -->
                    <fullMutationMatrix>true</fullMutationMatrix>
                </configuration>
                <executions>
                    <execution>
                        <id>mutation-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
